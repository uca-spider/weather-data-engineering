# ======================================
# Weather Data Pipeline - Environment Variables
# ======================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# ======================================
# GCP Configuration
# ======================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_ID=weather_data
GCP_REGION=us-central1

# Path to service account JSON key (relative to docker-compose mount)
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/credentials/gcp-credentials.json

# ======================================
# API Keys
# ======================================
# OpenWeatherMap API Key (get from: https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Open-Meteo API (no key required, but included for consistency)
# OPENMETEO_API_KEY=not_required

# ======================================
# Cities Configuration
# ======================================
# Comma-separated list of cities to track
CITIES=Jakarta,Surabaya,Bandung,Medan,Makassar

# ======================================
# Airflow Configuration
# ======================================
# Airflow user ID (for Docker permissions)
AIRFLOW_UID=50000

# Airflow executor type
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Don't load example DAGs
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Pause DAGs on creation (manual trigger required)
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True

# Airflow webserver port
AIRFLOW_WEBSERVER_PORT=8080

# Airflow admin user (default for local development)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ======================================
# PostgreSQL (Airflow Metadata Database)
# ======================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_PORT=5432

# ======================================
# Pipeline Configuration
# ======================================
# Pipeline schedule (cron format: every 6 hours at minute 0)
PIPELINE_SCHEDULE=0 */6 * * *

# Data retention in days (optional, for cleanup jobs)
DATA_RETENTION_DAYS=365

# ======================================
# Data Quality Configuration
# ======================================
# Enable/disable Great Expectations validation
ENABLE_DATA_QUALITY_CHECKS=True

# Temperature range validation (Celsius)
TEMP_MIN_THRESHOLD=-50
TEMP_MAX_THRESHOLD=60

# Humidity range validation (%)
HUMIDITY_MIN=0
HUMIDITY_MAX=100

# Pressure range validation (hPa)
PRESSURE_MIN=900
PRESSURE_MAX=1100

# ======================================
# Streamlit Configuration
# ======================================
# Streamlit port
STREAMLIT_PORT=8501

# Cache TTL in seconds (5 minutes)
STREAMLIT_CACHE_TTL=300

# ======================================
# Logging Configuration
# ======================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ======================================
# Notification Configuration (Optional)
# ======================================
# Email notifications (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# ALERT_EMAIL=your-email@gmail.com

# Slack notifications (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ======================================
# Development/Testing
# ======================================
# Set to 'development' or 'production'
ENVIRONMENT=development

# Enable debug mode (more verbose logging)
DEBUG=False
