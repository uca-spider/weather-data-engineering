# Weather Data Pipeline - environment variables
# Copy to .env and fill in real values. Never commit .env.
# Only the variables below are read by the code or docker-compose.yml.

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_ID=weather_data
# Location used when creating the dataset; use the region of your dataset
GCP_REGION=your-dataset-region

# Service account key, as seen from inside the Airflow containers
# (docker-compose mounts ./credentials to /opt/airflow/credentials)
GOOGLE_APPLICATION_CREDENTIALS=/opt/airflow/credentials/gcp-credentials.json

# OpenWeatherMap (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Airflow user ID for Docker file permissions (Linux/WSL; keep 50000 elsewhere)
AIRFLOW_UID=50000

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Free-form label read by the code
ENVIRONMENT=development